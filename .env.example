# Copia questo file in `.env` e compila i valori.
# Il file `.env` non viene pubblicato su git (vedi .gitignore).

# --- Gemini (opzionale) ---
# Chiave API di Gemini. Se il modello locale è primario, Gemini fa da riserva;
# se resta vuota, il modello locale è l'unico modello.
VALERIO_API=

# --- Modello locale (Ollama o altro server compatibile OpenAI) ---
# Nome esatto come appare in `ollama list`, tag compreso.
LOCAL_MODEL_NAME=qwen3.5:27b
LOCAL_MODEL_URL=http://localhost:11434/v1
# 1 = modello locale primario e Gemini come riserva; 0 = il contrario.
LOCAL_MODEL_PRIMARY=1
# Numero di documenti passati al modello locale (predefinito 3, pensato per
# modelli piccoli; con un modello grande conviene 6).
LOCAL_CONTEXT_DOCUMENTS=6
# LOCAL_MODEL_TIMEOUT=300
# LOCAL_MODEL_ATTEMPTS=1
# LOCAL_MODEL_MAX_TOKENS=0

# --- Embedding ---
# Deve essere un modello della famiglia multilingual-e5 (prefissi query:/passage:).
# Cambiandolo, l'indice Chroma si ricostruisce da solo al primo avvio.
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- Traduzione (LibreTranslate, opzionale) ---
# Lascia vuoto LIBRETRANSLATE_URL per usare solo il glossario interno.
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_LANGUAGES=en,it,uk,tl,bn,ar,zh
# LIBRETRANSLATE_API_KEY=
# LIBRETRANSLATE_TIMEOUT=10.0
# LIBRETRANSLATE_FAILURES=3
# LIBRETRANSLATE_COOLDOWN=60

# --- API HTTP ---
# Origini consentite per il CORS, separate da virgola.
# ANGULAR_ORIGINS=http://localhost:4200
# 1 = ricostruisce l'indice Chroma a ogni avvio dell'API.
# RESET_CHROMA=0

# --- Hugging Face ---
# 1 = nessun download: usa solo i modelli già in cache.
# Attivalo solo dopo il primo avvio, quando i modelli sono già scaricati.
# HF_HUB_OFFLINE=1
